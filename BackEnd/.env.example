# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/abricot?schema=public"

# JWT Secret - Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# Serveur
PORT=8000
NODE_ENV=development

# Frontend URL (pour CORS)
FRONTEND_URL="http://localhost:3000"

# Production sur Render:
# DATABASE_URL="<Internal Database URL from Render PostgreSQL>"
# FRONTEND_URL="https://abricot-nine.vercel.app"
# NODE_ENV="production"
